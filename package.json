{
  "name": "service-landing-page",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/serve.mjs",
    "styles": "sass scss/main.scss assets/css/main.css --style=compressed --no-source-map",
    "styles:watch": "sass --watch scss/main.scss:assets/css/main.css --no-source-map",
    "build": "npm run styles && node scripts/build.mjs",
    "check": "node scripts/check.mjs",
    "test": "node --test"
  },
  "devDependencies": {
    "sass": "^1.93.0"
  }
}
